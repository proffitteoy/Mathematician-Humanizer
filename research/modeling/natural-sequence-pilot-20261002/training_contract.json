    "kind": "masked_family_balanced_squared_next_unit_prediction",
    "primary_endpoints": [
      "matched_mean_minus_explicit_covariance_loss",
      "explicit_covariance_minus_learned_set_loss",
      "set_plus_covariance_minus_order_plus_same_covariance_loss"
    ],
    "aggregation": "observed channels within family; observed families within target; valid targets within document; jointly eligible answer variants within question; equal questions; equal H/ChatGPT arms",
    "smallest_useful_relative_reduction": 0.01,
    "primary_interval_level": 0.9833333333333333,
    "secondary_interval_level": 0.95,
    "bootstrap_replicates": 2000,
    "bootstrap_unit": "frozen_copy_component",
    "model_seeds_are_independent_data": false,
    "author_or_production_label_target": false,
    "likelihood_claim": "conditional_mean_prediction_only",
    "relative_gain_definition": "(paired_equal_arm_seed_averaged_aggregate_baseline_loss - paired_equal_arm_seed_averaged_aggregate_new_loss) / aggregate_baseline_loss",
    "positive_increment_evidence": "98.333333% lower confidence bound > 0",
    "useful_increment_evidence": "98.333333% lower confidence bound > 0.01",
    "zero_baseline_policy": "relative gain undefined; report absolute gain",
    "descriptive_composition_endpoint": "matched_mean_minus_learned_set_loss; not uniquely covariance"
  },
  "models": [
    "F0_training_mean",
