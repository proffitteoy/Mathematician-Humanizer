{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WikiConv frozen sample source/action feasibility packet 0.1.0",
  "description": "Private filled packets, public blank contract. Structure does not authenticate authors, chronology, linguistic labels or human origin. No measurements are created by counting fields.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "wikiconv-source-action-feasibility/0.1.0"
    },
    "status": {
      "enum": [
        "blank_unannotated",
        "assistant_provisional_only"
      ]
    },
    "study_scope": {
      "const": "local_frozen_sample_measurement_feasibility"
    },
    "automatic_H_G_conversion": {
      "const": false
    },
    "population_fitting_permitted": {
      "const": false
    },
    "natural_author_links_verified": {
      "const": 0
    },
    "empirical_temporal_episodes_admitted": {
      "const": 0
    },
    "annotation_provenance": {
      "const": "assistant_generated_not_independent_human_gold"
    },
    "source_views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "view_key": {
            "type": "string",
            "minLength": 1
          },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "archive_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "member": {
                "const": "utterances.jsonl"
              },
              "scanner_version": {
                "const": "wikiconv-annual-structural/0.1.0"
              },
              "row_number": {
                "type": "integer",
                "minimum": 1
              },
              "byte_offset": {
                "type": "integer",
                "minimum": 0
              },
              "view_seq": {
                "type": "integer",
                "minimum": 1
              },
              "json_pointer": {
                "type": "string"
              },
              "source_role": {
                "enum": [
                  "top_level",
                  "original",
                  "modification",
                  "deletion",
                  "restoration"
                ]
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "archive_sha256",
              "member",
              "scanner_version",
              "row_number",
              "byte_offset",
              "view_seq",
              "json_pointer",
              "source_role",
              "source_id",
              "text_sha256"
            ]
          },
          "text_ref": {
            "type": "string",
            "minLength": 1
          },
          "codepoint_length": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "view_key",
          "anchor",
          "text_ref",
          "codepoint_length"
        ]
      }
    },
    "content_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "view_key": {
            "type": "string",
            "minLength": 1
          },
          "provisional_content_role": {
            "enum": [
              "header",
              "formulaic_moderation_notice",
              "single_prose_body_candidate",
              "template_fragment",
              "attribution_marker_only",
              "punctuation_signature_remnant",
              "numeric_reaction",
              "bundled_signed_prose",
              "unresolved"
            ]
          },
          "substantive_chinese_prose": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "timestamp_signature_cue_spans": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "start",
                "end"
              ]
            }
          },
          "natural_author_evidence": {
            "const": "unknown"
          },
          "text_production_evidence": {
            "const": "unknown"
          }
        },
        "required": [
          "view_key",
          "provisional_content_role",
          "substantive_chinese_prose",
          "timestamp_signature_cue_spans",
          "natural_author_evidence",
          "text_production_evidence"
        ]
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "context_id": {
            "type": "string",
            "minLength": 1
          },
          "ordered_view_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "display_order_rule": {
            "type": "string",
            "minLength": 1
          },
          "order_semantics": {
            "const": "display_convention_only"
          },
          "historical_visibility": {
            "const": "unknown"
          },
          "empirical_event_order_claim": {
            "const": false
          },
          "context_gap_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "context_id",
          "ordered_view_keys",
          "display_order_rule",
          "order_semantics",
          "historical_visibility",
          "empirical_event_order_claim",
          "context_gap_notes"
        ]
      }
    },
    "action_units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "view_key": {
            "type": "string",
            "minLength": 1
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "start",
                "end"
              ]
            }
          },
          "candidate_analyses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "functions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "functions"
              ]
            }
          },
          "actor_basis": {
            "const": "candidate_discourse_voice_only"
          },
          "context_id": {
            "type": "string",
            "minLength": 1
          },
          "relation_target_action_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "production_time_status": {
            "const": "unresolved"
          },
          "empirical_transition_eligible": {
            "const": false
          },
          "coverage_claim": {
            "const": "selected_action_units_only"
          }
        },
        "required": [
          "action_id",
          "view_key",
          "spans",
          "candidate_analyses",
          "actor_basis",
          "context_id",
          "relation_target_action_ids",
          "production_time_status",
          "empirical_transition_eligible",
          "coverage_claim"
        ]
      }
    },
    "referential_packet_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "study_scope",
    "automatic_H_G_conversion",
    "population_fitting_permitted",
    "natural_author_links_verified",
    "empirical_temporal_episodes_admitted",
    "annotation_provenance",
    "source_views",
    "content_reviews",
    "contexts",
    "action_units",
    "referential_packet_ref",
    "notes"
  ]
}
