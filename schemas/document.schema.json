{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:style-compiler:document:1.0.0",
  "title": "Non-personal research document",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "document/1.0.0"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "genre": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "language",
        "genre",
        "topic",
        "task"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "cohort": {
          "enum": [
            "H_G",
            "A_G",
            "A_H",
            "A_C",
            "unknown",
            "synthetic_test"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "rights_basis": {
          "type": "string",
          "minLength": 1
        },
        "rights_verified": {
          "type": "boolean"
        },
        "is_synthetic": {
          "type": "boolean"
        },
        "author_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "generator_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance_verified": {
          "type": "boolean"
        },
        "assistance_status": {
          "enum": [
            "unassisted",
            "assisted",
            "unknown",
            "not_applicable"
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "cohort",
        "source_id",
        "rights_basis",
        "rights_verified",
        "is_synthetic"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "cohort": {
                "const": "synthetic_test"
              }
            }
          },
          "then": {
            "properties": {
              "is_synthetic": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "leakage": {
      "type": "object",
      "properties": {
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "lineage_id": {
          "type": "string",
          "minLength": 1
        },
        "content_group_id": {
          "type": "string",
          "minLength": 1
        },
        "near_duplicate_group_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_family_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "work_id",
        "lineage_id",
        "content_group_id",
        "near_duplicate_group_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "document_id",
    "text",
    "context",
    "provenance",
    "leakage"
  ],
  "additionalProperties": false
}
